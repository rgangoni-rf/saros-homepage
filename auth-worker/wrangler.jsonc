{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "saros-cms-auth",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    // Endereço do site (onde fica o /admin), sem barra no final. Ex.: https://saros-homepage.SEU-SUBDOMINIO.workers.dev
    "ALLOWED_ORIGIN": "https://saros-homepage.rgangoni.workers.dev",
    // Cloudflare Zero Trust → Settings → Custom pages / ou na tela do app Access. Ex.: suaequipe.cloudflareaccess.com
    "TEAM_DOMAIN": "muddy-sea-e2f7.cloudflareaccess.com",
    // "Application Audience (AUD) Tag" do aplicativo Access deste Worker
    "POLICY_AUD": "26c31a68d935841d7e24a60c66148d8ac24f223eea2883dff6fd03d179e84038"
  }
}
